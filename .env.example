# Datos que da el DBA. Usar un usuario con permisos de SOLO LECTURA (SELECT).
ORACLE_USER=usuario_lectura
ORACLE_PASSWORD=cambiar
# host:puerto/SERVICE_NAME
ORACLE_DSN=servidor-oracle.empresa.local:1521/SERVICIO
ORACLE_POOL_MAX=4
# Solo si la base es anterior a Oracle 12.1 (ruta al Instant Client)
ORACLE_CLIENT_LIB_DIR=

# URL del front React (separadas por coma si hay varias)
CORS_ORIGINS=http://localhost:5173
